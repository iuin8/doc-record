<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fa.sshfs.mount</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/fa/Library/Scripts/sshfs_auto_mount.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/fa/Library/Logs/sshfs_mount.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fa/Library/Logs/sshfs_mount.err.log</string>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>