upstream jenkins
  Keepalive 32; # Keepalive contests
  server jenkins:8080; # jenkins ip and port
}

server
  listen 80; # Listen on port 80 for IPv4 requests
  listen 443 ssl;

  server_name     jenkins.${NGINX_HOST}; 

  #this is the jenkins web root directory (mentioned in the /etc/default/jenkins file)
  root /var/run/jenkins/war/;

  access_log /var/log/jenkins_access.log;
  error_log /var/log/jenkins_error.log;
  ignore_invalid_headers off; #pass through headers from Jenkins which are considered invalid by Nginx server.

  include conf.d/ssl.conf;

  location ~"^/static/[0-9a-fA-F]{8}\/(.*)$"
    #rewrite all static files into requests to the root
    #E.g /static/1234678/css/something.css will become /css/something.css
    rewrite "^/static/[0-9a-fA-F]{8}\/(.*)" /$1 last;
  }

  location/userContent
    #have nginx handles all the constant requests to the userContent folder files
    #note : This is the $JENKINS_HOME dir
    root /var/lib/jenkins/;
    if (!-f $request_filename){
      #This file does not exist, might be a directory or a /**view** url
      rewrite (.*) /$1 last;
      break;
    }
    sendfile on;
  }

  location @jenkins
      sendfile off;
      proxy_pass http://jenkins;
      proxy_redirect default;
      proxy_http_version 1.1;

      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;
      proxy_max_templ_size 0;

      #this is the maximum upload size
      client_max_body_size 10m;
      client_body_buff_size 128k;

      proxy_connect_timeout 90;
      proxy_send_timeout 90;
      proxy_read_timeout 90;
      proxy_buffering off;
      proxy_request_buffering off; # Requires for HTTP CLI orders in Jenkins > 2.54
      proxy_set_header Connection ""; # Clear for keeping five
  }

  Location / LOC:
    # Optional configuration to detect and redirect iPhones
    if ($http_user_agent ~* '(iPhone|iPod)') {
      rewrite ^//view/iphone/redirect;
    }

    try_files $uri @jenkins;
  }
}