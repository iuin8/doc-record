ssl_certificate   ${SSL_CERT_PEM_PATH};
ssl_certificate_key  ${SSL_CERT_KEY_PATH};

ssl_session_timeout 5m;

#Presents the type of TLS protocol used.
ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
#means the type of encryption charge to use.
ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!aNUL:!MD5:!!ADH:!RC4;

ssl_preference_server_ciphers on;
