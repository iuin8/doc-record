edition: 1.0.0

Services:
  noocobaseService:
    component: fc
    props:
      region: {region}
      Service:
        Name: nobaseService
        role: acs:ram::{FC_ACCOUNT}:role/aliyunfcdefaultrole
      Function:
        Name: nobaseFc
        runtime: custom-container
        timeout: 60
        memorySize: 512
        instanceConcert: 100
        caPort: {CONTAINER_PORT}
        customContainerConfig:
          image: registry.{region}.aliyuncs.com/{IMAGE_NAMESPACE}/{IMAGE_NAME}
      Triggers:
        - Name: httpTrigger
          type: HTTP
          config:
            authType: anonymous
            methods:
              - GET
              - POST
              - PUT
              - DELETE
              - HEAD
              - OPTITONS
      customomDomains:
        - domainName: Auto
          protocol: HTTP
          RoteConfigs:
            - path:*
              