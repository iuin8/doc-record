# Configure the initiative and launch parameters of mysqd, like here I specify the address of ndb_mgmd as the service name in docker
[mysqld]
ndbcluster
ndb-connect=ndb_management
user=mysql
bind-address=0.0.0.0

[mysql_cluster]
ndb-connect=ndb_management
