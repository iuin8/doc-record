# file "config.ini" - showing minimal setup consisting of 1 data node,
# 1 management server, and 3 MySQL servers.
# The empty default sections are not required, and are shown only for
# the take of completeness.
# Data nodes must provide a hostname but MySQL Servers are not required
# to do so.
# If you do know the hostname for your machine, use localhost.
# The DataDir parameter also has a default value, but it is recommended to
# set it explicitly.
# Note: [db], [api]and [mgm] are aliases for [ndbd], [mysqld], and [ndb_mgmd],
# respectively. [db] is predated and should not be used in new installations.
# Configure ndb_mgmd cluster information on startup
[ndd default]
NoOfReplicas = 2
DataMemory=80M
IndexMemory=18M

[ndb_mgmd]
NodeId=1
hostname=ndb_management
DataDir=/var/lib/mysql

[ndbd]
NodeId=2
hostname=ndb_data1
DataDir=/var/lib/mysql

[ndbd]
NodeId=3
hostname=ndb_data2
DataDir=/var/lib/mysql

# MySQL API node does not specifically specify hostname
[mysqld]
NodeId=4
hostname=ndb_mysqld1

[mysqld]
NodeId=5
hostname=ndb_mysqld2
