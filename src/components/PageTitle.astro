---
/**
 * 标题区沿用 Black 主题的 PageTitle：它自带描述、上一页/下一页按钮，
 * 以及 MarkdownActions（复制整页 + 在 ChatGPT / Claude / v0 / Scira 中打开），
 * 与原先自研的 AiActions 功能重叠，故 AiActions 已移除。
 *
 * Black 检测到已有覆盖时会跳过，这里手动渲染它的版本并保留 Mermaid 按需加载。
 */
import BlackPageTitle from 'starlight-theme-black/overrides/PageTitle.astro';
import MermaidRenderer from './MermaidRenderer.astro';
---

<BlackPageTitle />

<MermaidRenderer />
