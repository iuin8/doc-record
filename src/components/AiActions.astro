---
interface Props {
  /** 当前页面对应的原始 Markdown 路径 */
  rawPath: string;
  absoluteUrl: string;
}

const { rawPath, absoluteUrl } = Astro.props;

const t = Astro.locals.t;
const prompt = `${t('aiActions.prompt')}${absoluteUrl}`;
const chatGptUrl = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;

/**
 * 问答链路有两套，取决于是否配置了自建生成端。
 *
 * 配置 PUBLIC_AI_ANSWER_URL 时走「浏览器端 Pagefind 召回 + 自建生成端」：
 * Pagefind 索引在构建期生成，中文分词可用，召回在客户端完成且不消耗
 * Workers AI 额度，生成端只负责依据片段作答。
 *
 * 未配置时回退到 NLWeb 的 /ask：英文与标识符可用，含中文的查询会被
 * NLWeb 侧过滤，见 adr/2026-09-14-AI-Search-容量限流调优.md §6.3。
 */
const answerEndpoint = import.meta.env.PUBLIC_AI_ANSWER_URL ?? '';
const nlwebEndpoint =
  import.meta.env.PUBLIC_NLWEB_ASK_URL ??
  'https://bold-union-4896-nlweb.iuinin666.workers.dev/ask';
const useLocalRecall = Boolean(answerEndpoint);
const askEndpoint = useLocalRecall ? answerEndpoint : nlwebEndpoint;
---

<div class="ai-block">
  <div class="ai-actions">
    <button
      type="button"
      class="ai-btn"
      data-raw={rawPath}
      data-copied={t('aiActions.copied')}
      data-failed={t('aiActions.copyFailed')}
    >
      {t('aiActions.copy')}
    </button>
    <a class="ai-link" href={chatGptUrl} target="_blank" rel="noopener noreferrer">
      {t('aiActions.openInChatGpt')}
    </a>
    <a class="ai-link" href={claudeUrl} target="_blank" rel="noopener noreferrer">
      {t('aiActions.openInClaude')}
    </a>
    <button type="button" class="ai-btn ai-ask-toggle" aria-expanded="false">
      {t('aiActions.ask')}
    </button>
    <span class="ai-status" role="status" aria-live="polite"></span>
  </div>

  <div
    class="ai-ask"
    hidden
    data-endpoint={askEndpoint}
    data-recall={String(useLocalRecall)}
    data-pending={t('aiActions.askPending')}
    data-empty={t('aiActions.askEmpty')}
    data-failed={t('aiActions.askFailed')}
    data-sources={t('aiActions.askSources')}
  >
    <form class="ai-ask-form">
      <input
        class="ai-ask-input"
        type="search"
        name="query"
        required
        placeholder={t('aiActions.askPlaceholder')}
      />
      <button class="ai-btn" type="submit">{t('aiActions.askSubmit')}</button>
    </form>
    <div class="ai-ask-result" role="status" aria-live="polite"></div>
  </div>
</div>

<script>
  interface AskResult {
    url?: string;
    name?: string;
    description?: string;
  }

  interface AskMessage {
    message_type?: string;
    results?: AskResult[];
    content?: string;
    answer?: string;
  }

  /** 交给生成端的片段。URL 需为绝对地址，生成端据此校验片段归属。 */
  interface AnswerContext {
    url: string;
    title: string;
    text: string;
  }

  interface PagefindResultData {
    url: string;
    content: string;
    excerpt: string;
    meta?: { title?: string };
  }

  /** 命中项。`id` 用于多次检索之间的结果融合。 */
  interface PagefindHit {
    id: string;
    data(): Promise<PagefindResultData>;
  }

  interface PagefindModule {
    init(): Promise<void>;
    search(query: string): Promise<{ results: PagefindHit[] }>;
  }

  /** 把 SSE 文本流切成完整的 `data:` 事件载荷。 */
  function parseEvents(chunk: string): AskMessage[] {
    const messages: AskMessage[] = [];
    for (const block of chunk.split('\n\n')) {
      for (const line of block.split('\n')) {
        if (!line.startsWith('data:')) continue;
        const payload = line.slice(5).trim();
        if (!payload || payload === '[DONE]') continue;
        try {
          messages.push(JSON.parse(payload) as AskMessage);
        } catch {
          // 心跳或非 JSON 行直接忽略
        }
      }
    }
    return messages;
  }

  function stripMarkup(text: string): string {
    return text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  /** 中文虚词与疑问词。长句检索时剔除，避免高频虚词占掉匹配名额。 */
  const STOP_TERMS = new Set([
    '的', '了', '是', '吗', '呢', '啊', '吧', '我', '你', '它', '这', '那',
    '有', '在', '和', '与', '或', '就', '也', '很', '到', '要', '会', '着',
    '被', '把', '给', '对', '个', '们', '请', '问', '怎么', '怎样', '如何',
    '什么', '哪些', '哪个', '为什么', '可以', '能否', '有没有', '多少',
  ]);

  interface WordSegmenter {
    segment(input: string): Iterable<{ segment: string }>;
  }

  /** 浏览器原生中文分词；不支持时返回 null，调用方退回按空白切分。 */
  function createSegmenter(): WordSegmenter | null {
    const ctor = (
      Intl as unknown as {
        Segmenter?: new (locale: string, options: { granularity: string }) => WordSegmenter;
      }
    ).Segmenter;
    return ctor ? new ctor('zh', { granularity: 'word' }) : null;
  }

  /** 把长句拆成可独立检索的词，剔除虚词与单字。 */
  function splitTerms(query: string): string[] {
    const segmenter = createSegmenter();
    const parts = segmenter
      ? [...segmenter.segment(query)].map((item) => item.segment)
      : query.split(/\s+/);
    return [...new Set(parts)]
      .map((term) => term.trim())
      .filter((term) => term.length > 0 && !STOP_TERMS.has(term) && !/^[一-鿿]$/.test(term));
  }

  /**
   * 多词分别检索后融合排名（RRF）：被越多词命中、且在各自结果中越靠前的
   * 片段排得越前。不同查询的分数不可直接比较，故只用名次。
   */
  function fuseRankings(lists: string[][]): string[] {
    const scores = new Map<string, number>();
    for (const list of lists) {
      list.forEach((id, index) => {
        scores.set(id, (scores.get(id) ?? 0) + 1 / (60 + index + 1));
      });
    }
    return [...scores.entries()].sort((a, b) => b[1] - a[1]).map(([id]) => id);
  }

  function buildSources(label: string, items: AskResult[]): DocumentFragment {
    const fragment = document.createDocumentFragment();

    if (items.length > 0) {
      const heading = document.createElement('p');
      heading.className = 'ai-ask-sources';
      heading.textContent = label;
      fragment.append(heading);

      const list = document.createElement('ol');
      for (const item of items) {
        if (!item.url) continue;
        const entry = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.name ?? item.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        entry.append(link);
        if (item.description) {
          const text = document.createElement('p');
          text.textContent = item.description;
          entry.append(text);
        }
        list.append(entry);
      }
      fragment.append(list);
    }

    return fragment;
  }

  /**
   * 浏览器端召回。Pagefind 索引由构建期生成，中文分词可用；
   * `astro dev` 下没有该产物，调用会失败并由调用方回退或提示。
   */
  async function localRecall(query: string, limit = 6) {
    const modulePath = '/pagefind/pagefind.js';
    const pagefind = (await import(/* @vite-ignore */ modulePath)) as unknown as PagefindModule;
    await pagefind.init();

    let found: PagefindHit[] = (await pagefind.search(query)).results.slice(0, limit);

    // Pagefind 对多个词要求同时命中同一文档，因此长句里只要有一个词与文档无关，
    // 结果就是 0。实测「nsenter 的改动是持久化的吗」为 0，而拆出的
    // 「nsenter」「持久」分别有 3 条与 4 条命中。故整句无结果时改为
    // 按词分别检索，再融合排名。
    if (found.length === 0) {
      const terms = splitTerms(query);
      if (terms.length > 0) {
        const lists: string[][] = [];
        const pool = new Map<string, PagefindHit>();
        for (const term of terms) {
          const search = await pagefind.search(term);
          lists.push(search.results.map((item) => item.id));
          for (const item of search.results) {
            if (!pool.has(item.id)) pool.set(item.id, item);
          }
        }
        found = fuseRankings(lists)
          .slice(0, limit)
          .map((id) => pool.get(id))
          .filter((item): item is PagefindHit => Boolean(item));
      }
    }

    const picked = await Promise.all(found.map((result) => result.data()));

    const hits: AskResult[] = [];
    const contexts: AnswerContext[] = [];
    for (const item of picked) {
      const url = new URL(item.url, window.location.origin).href;
      const title = item.meta?.title ?? item.url;
      hits.push({ url, name: title, description: stripMarkup(item.excerpt ?? '') });
      contexts.push({ url, title, text: stripMarkup(item.content ?? '') });
    }
    return { hits, contexts };
  }

  /** 逐段读取 SSE，把解析出的消息交给调用方。 */
  async function readStream(response: Response, onMessage: (message: AskMessage) => void) {
    if (!response.body) throw new Error('empty body');
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const boundary = buffer.lastIndexOf('\n\n');
      if (boundary === -1) continue;
      const complete = buffer.slice(0, boundary + 2);
      buffer = buffer.slice(boundary + 2);
      for (const message of parseEvents(complete)) onMessage(message);
    }
  }

  /** 本地召回 + 自建生成端：中文查询可用。 */
  async function askWithLocalRecall(panel: HTMLElement, output: HTMLElement, query: string) {
    const { hits, contexts } = await localRecall(query);

    if (hits.length === 0) {
      output.textContent = panel.dataset.empty ?? '';
      return;
    }

    output.replaceChildren();
    const answer = document.createElement('p');
    answer.className = 'ai-ask-answer';
    output.append(answer);
    output.append(buildSources(panel.dataset.sources ?? '', hits));

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, contexts }),
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    await readStream(response, (message) => {
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) answer.textContent += text;
    });

    if (!answer.textContent) answer.textContent = panel.dataset.empty ?? '';
  }

  /** 回退路径：NLWeb 自行检索并生成，中文查询会被其过滤。 */
  async function askNlweb(panel: HTMLElement, output: HTMLElement, query: string) {
    const collected: AskResult[] = [];
    const notes: string[] = [];

    const response = await fetch(panel.dataset.endpoint ?? '', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, mode: 'generate', site: 'all' }),
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    await readStream(response, (message) => {
      if (message.results) collected.push(...message.results);
      const text = message.answer ?? message.content;
      if (typeof text === 'string' && text) notes.push(text);
    });

    output.replaceChildren();
    const answer = document.createElement('p');
    answer.textContent = notes.join(' ');
    output.append(answer);
    output.append(buildSources(panel.dataset.sources ?? '', collected));
  }

  const blocks = document.querySelectorAll<HTMLElement>('.ai-block');

  blocks.forEach((block) => {
    const toggle = block.querySelector<HTMLButtonElement>('.ai-ask-toggle');
    const panel = block.querySelector<HTMLElement>('.ai-ask');
    const form = block.querySelector<HTMLFormElement>('.ai-ask-form');
    const input = block.querySelector<HTMLInputElement>('.ai-ask-input');
    const output = block.querySelector<HTMLElement>('.ai-ask-result');
    const copyButton = block.querySelector<HTMLButtonElement>('.ai-actions .ai-btn');
    const status = block.querySelector<HTMLElement>('.ai-status');
    if (!toggle || !panel || !form || !input || !output) return;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
      if (!expanded) input.focus();
    });

    if (copyButton && status) {
      copyButton.addEventListener('click', async () => {
        try {
          const response = await fetch(copyButton.dataset.raw ?? '');
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          await navigator.clipboard.writeText(await response.text());
          status.textContent = copyButton.dataset.copied ?? '';
        } catch {
          status.textContent = copyButton.dataset.failed ?? '';
        }
        window.setTimeout(() => {
          status.textContent = '';
        }, 2000);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const query = input.value.trim();
      if (!query) return;

      output.textContent = panel.dataset.pending ?? '';

      try {
        if (panel.dataset.recall === 'true') {
          await askWithLocalRecall(panel, output, query);
        } else {
          await askNlweb(panel, output, query);
        }
      } catch {
        output.textContent = panel.dataset.failed ?? '';
      }
    });
  });
</script>

<style>
  .ai-block {
    margin-top: 1rem;
  }

  .ai-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  .ai-btn,
  .ai-link {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font-size: inherit;
    line-height: 1.6;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-btn:hover,
  .ai-link:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  .ai-btn[aria-expanded='true'] {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  .ai-status {
    min-width: 3.5rem;
    color: var(--sl-color-gray-3);
  }

  .ai-ask {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  .ai-ask-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ai-ask-input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
  }

  .ai-ask-input:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .ai-ask-result {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    line-height: 1.7;
  }

  .ai-ask-result :global(ol) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .ai-ask-result :global(li) {
    margin-bottom: 0.5rem;
  }

  .ai-ask-result :global(a) {
    color: var(--sl-color-white);
  }

  .ai-ask-result :global(p) {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-3);
  }

  .ai-ask-answer {
    margin: 0 0 0.75rem;
    white-space: pre-wrap;
  }

  .ai-ask-sources {
    margin: 0 0 0.5rem;
    color: var(--sl-color-gray-3);
  }
</style>
