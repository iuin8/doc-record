# 复制为 weblate/.env 后按实际环境填写。该文件包含凭据，不要提交。
# 变量说明见 https://docs.weblate.org/en/latest/admin/install/docker.html

# Weblate 基础设置
WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO
WEBLATE_SITE_TITLE=Weblate
WEBLATE_SITE_DOMAIN=weblate.example.com
WEBLATE_ALLOWED_HOSTS=weblate.example.com
WEBLATE_ADMIN_NAME=Weblate Admin
WEBLATE_ADMIN_EMAIL=weblate@example.com
WEBLATE_ADMIN_PASSWORD=change-me
WEBLATE_SERVER_EMAIL=weblate@example.com
WEBLATE_DEFAULT_FROM_EMAIL=weblate@example.com
WEBLATE_REGISTRATION_OPEN=0
WEBLATE_TIME_ZONE=Asia/Shanghai

# 反向代理终止 TLS 时启用以下三项
# WEBLATE_ENABLE_HTTPS=1
# WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
# WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# PostgreSQL
POSTGRES_PASSWORD=change-me
POSTGRES_USER=weblate
POSTGRES_DB=weblate
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DATABASE=weblate

# 缓存
REDIS_HOST=cache
REDIS_PORT=6379

# 邮件服务，需监听 587 并支持 TLS
WEBLATE_EMAIL_HOST=smtp.example.com
WEBLATE_EMAIL_HOST_USER=
WEBLATE_EMAIL_HOST_PASSWORD=

CLIENT_MAX_BODY_SIZE=1000M
