{
  // 独立的最小配置：仓库根的 tsconfig 继承 astro/tsconfigs/strict，
  // wrangler 在子目录运行时会向上查找并报找不到 base config。
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/**/*.js"]
}
